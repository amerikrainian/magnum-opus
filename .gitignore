# The game analysis workspace (original/deobfuscated/named exes, the decompile, the derived
# reference assembly and fingerprints): regenerated by tools/prepare-game.ps1 and the build,
# never committed. We ship no game code. Anchored: an unanchored "game/" would also swallow
# src/MagnumOpus.Module/Game/ (git on Windows matches ignore patterns case-insensitively).
/game/

# Build output
bin/
obj/
*.user
.vs/

# Machine-specific build overrides
Directory.Build.local.props

# Extracted tools and reference material (third_party/ holds the vendored, committed inputs;
# the QuintessentialOM clones and downloaded releases are local reference only)
/tools/de4dot/
/third_party/quintessential-*/
/third_party/downloads/
*.nupkg

# Release artifacts (build_release.ps1, build-installer.ps1) and the installer's cargo output
releases/
installer/target/

# The rendered manual (mdbook build docs_src)
docs_src/book/
