<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the engine-free side: Names (the mapping pipeline), Core, Contracts. No game
       launch. The few tests that read the real game exe (game\Lightning.orig.exe) skip themselves
       when the analysis workspace is absent. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <RootNamespace>MagnumOpus.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MagnumOpus.Names\MagnumOpus.Names.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

</Project>
