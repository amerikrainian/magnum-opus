<Project Sdk="Microsoft.NET.Sdk">

  <!-- The name pipeline's command line (see CLAUDE.md "Names"): import community mappings into
       mappings/, generate the human-named compile reference, check a new game build. A developer
       tool: nothing from it ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>NameTool</AssemblyName>
    <RootNamespace>MagnumOpus.NameTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MagnumOpus.Names\MagnumOpus.Names.csproj" />
  </ItemGroup>

</Project>
