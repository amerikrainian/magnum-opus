<?xml version="1.0" encoding="utf-8"?>
<!-- Magnum Opus hookup. Placed next to Lightning.exe, this makes the CLR instantiate
     MagnumOpus.Bootstrap (our AppDomainManager) inside the stock game process before any game code
     runs; see src/MagnumOpus/Bootstrap.cs. Opus Magnum ships no .exe.config of its own, so this file
     is purely additive: delete it to launch fully vanilla. The display name below must match the
     built host exactly; AssemblyVersion is pinned to 1.0.0.0 in MagnumOpus.csproj for that reason. -->
<configuration>
  <runtime>
    <appDomainManagerAssembly value="MagnumOpus, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="MagnumOpus.Bootstrap" />
  </runtime>
</configuration>
